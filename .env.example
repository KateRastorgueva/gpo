# =========================
# Core project settings
# =========================
PROJECT_NAME=Full Stack FastAPI Project
STACK_NAME=full-stack-fastapi-project
DOMAIN=localhost
ENVIRONMENT=local
FRONTEND_HOST=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173,https://localhost,https://localhost:5173,http://localhost.tiangolo.com
SECRET_KEY=changethis

# =========================
# Auth / admin
# =========================
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# =========================
# Database
# =========================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
POSTGRES_DB=app
# Имя базы для тестового прогона: тесты очищают таблицы, поэтому рабочая база не подходит.
# Используется scripts/tests-start.sh, если не переопределено переменной окружения.
TEST_POSTGRES_DB=app_test

# =========================
# Docker images
# =========================
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
TAG=latest

# =========================
# Email / monitoring
# =========================
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@example.com
EMAIL_TEST_USER=test@example.com
SENTRY_DSN=

# =========================
# LLM providers
# =========================
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-flash-latest
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_API_URL=https://generativelanguage.googleapis.com/v1beta

# Ключ AI Studio (aistudio.google.com/apikey). Если пусто, берётся GOOGLE_API_KEY.
GEMINI_API_KEY=
# Кто отвечает после промаха FAQ: legacy | gemini_file_search | anythingllm
RAG_PROVIDER=legacy
# Имя хранилища из `python scripts/gemini_file_search.py create`
GEMINI_FILE_SEARCH_STORE=
GEMINI_FILE_SEARCH_MODEL=gemini-2.5-flash
# AnythingLLM: ключ из Settings -> Developer API, slug workspace
ANYTHINGLLM_BASE_URL=http://anythingllm:3001
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_WORKSPACE=tusur

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=30

# =========================
# Vector DB / RAG
# =========================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=knowledge_chunks
QDRANT_TIMEOUT_SECONDS=30

EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

FAQ_SIMILARITY_THRESHOLD=0.90
RAG_TOP_SCORE_THRESHOLD=0.72
RAG_RELEVANT_CHUNK_THRESHOLD=0.60
CRITICAL_CONFIDENCE_THRESHOLD=0.80
LOW_CONFIDENCE_MIN=0.65
LOW_CONFIDENCE_MAX=0.79
RETRIEVAL_TOP_K=5

HYBRID_CANDIDATES_LIMIT=20
HYBRID_SEMANTIC_WEIGHT=0.7
HYBRID_LEXICAL_WEIGHT=0.3
RERANK_WEIGHT=0.25

CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# =========================
# Optional: telegram profile
# =========================
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
SEARCH_API_KEY=

# Optional for playwright container
CI=
